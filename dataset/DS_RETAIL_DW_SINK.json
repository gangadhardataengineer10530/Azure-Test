{
	"name": "DS_RETAIL_DW_SINK",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_RETAILNER_OUTPUT",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"TableName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(\n    dataset().TableName,\n    '.csv'\n)",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(\n    dataset().TableName,\n    '/',\n    formatDateTime(\n        convertTimeZone(utcNow(),'UTC','India Standard Time'),\n        'yyyy/MM/dd'\n    )\n)",
					"type": "Expression"
				},
				"fileSystem": "retailerdw"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}